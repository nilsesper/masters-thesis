%%% List of all used acronyms
% Syntax:
% \DeclareAcronym{ACRONYM}{ short=ACRONYM, long=MEANING, }
% Usage:
% \ac{ACRONYM}: once "long (short)", then "short"
% \acp: plural
% \acf: second first time as \ac
% \acs: always "short"
% \acl: always "long"
% \acsp: always plural "short"
% \aclp: always plural "long"

\DeclareAcronym{SM}{
  short=SM,
  long=Standard Model of particle physics,
}
\DeclareAcronym{MiP}{
  short=MiP,
  long=Minimum ionizing particle,
}
\DeclareAcronym{PMT}{
  short=PMT,
  long=Photomultiplier tube,
}
\DeclareAcronym{SiPM}{
  short=SiPM,
  long=Silicon photomultiplier,
}
\DeclareAcronym{GAPD}{
  short=GAPD,
  long=Geiger-Avalance photodiode,
}
\DeclareAcronym{p.e.}{
  short=p.e.,
  long=photo-electron equivalent,
}

